{
  "name": "gcsimulator-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CONTACT_FROM": "GC Simulator <contact@mg.gcsimulator.org>",
    "MAILGUN_DOMAIN": "mg.gcsimulator.org",
    "MAILGUN_REGION": "US"
  },
  "keep_vars": true
}
